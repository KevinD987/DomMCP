{
  "_comment": "SHIPPING SEED — clean delivery default. First boot of `load dommcp_addin` (no path) seeds dommcp/dommcpcfg.nsf from this file; thereafter the NSF is the source of truth (NSF=Truth). Intentionally token-less: provision the first admin on the server console with `tell dommcp provision-admin <secret>` (see docs/INSTALL_HOWTO.md). The license is a placeholder — drop a signed dommcp/dommcp-license.json next to the NSF (issue_license.sh) before/after first boot. Do NOT put customer data, real license codes, or secrets (certifier password) in this file. The dev/test fixture with demo tokens lives in config/dev-config.json.",
  "server": {
    "name": "DomMCP",
    "server_active": true,
    "config_database": "dommcpcfg.nsf",
    "audit_database": "dommcpaudit.nsf",
    "listen_host": "0.0.0.0",
    "listen_port": 8088,
    "reload_interval_seconds": 60,
    "request_timeout_ms": 15000,
    "max_response_bytes": 65536,
    "default_page_size": 25,
    "max_page_size": 100,
    "allow_hidden_views": false,
    "cors_origin": "",
    "log_level": "info",
    "default_masking_mode": "exclude",
    "default_response_profile": "lean",
    "license_file_path": "",
    "license_public_key": "",
    "license_domain": "",
    "license_validation_ttl_seconds": 60,
    "license_strict_entitlements": false,
    "license_version_unverified_is_error": false,
    "license_quota_store_path": "",
    "lean_tool_result": true,
    "certifier_id_path": "",
    "certifier_password": ""
  },
  "audit": {
    "level": "standard",
    "retention_days": 30,
    "sensitive_fields": [
      "SSN",
      "Password"
    ],
    "masked_fields": [
      "SSN"
    ]
  },
  "license": {
    "license_code": "",
    "status": "unlicensed",
    "issued_to_domain": "",
    "valid_until": "",
    "edition": "",
    "features": [],
    "last_validation_at": "",
    "last_validation_error": ""
  },
  "tokens": [],
  "grants": [
    {
      "grant_id": "super-admin",
      "server": "",
      "path": "",
      "title": "Super Admin - All Databases",
      "description": "Full administrative capability template. No token references it until you run `tell dommcp provision-admin <secret>` on the server console, which mints an admin Token bound to this grant.",
      "status": "active",
      "allow_all_databases": true,
      "allow_system_database": true,
      "design_write_allowed": true,
      "acl_write_allowed": true,
      "database_create_allowed": true,
      "document_write_allowed": true,
      "allowed_tools": [
        "*"
      ],
      "allowed_views": [],
      "allowed_forms": [],
      "allowed_fields": [],
      "excluded_fields": [],
      "masked_fields": [],
      "full_text_allowed": true,
      "formula_search_allowed": true,
      "view_access_allowed": true,
      "document_direct_access_allowed": true,
      "summary_only": false,
      "max_results": 20000,
      "max_field_bytes": 1048576,
      "max_response_bytes": 10485760
    }
  ],
  "profiles": [],
  "remote_mcp_servers": []
}
